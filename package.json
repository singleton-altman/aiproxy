{
  "name": "ai-proxy-mobile",
  "version": "0.1.2",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-expo-modules-jsi.mjs",
    "check:version": "node scripts/version.mjs --check",
    "version:bump": "node scripts/version.mjs",
    "generate:endpoints": "node scripts/generate-endpoints.mjs",
    "check:endpoints": "node scripts/generate-endpoints.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify": "npm run check:version && npm run check:endpoints && npm run typecheck && npm run test && npm audit --audit-level=low",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios"
